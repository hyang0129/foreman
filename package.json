{
  "name": "foreman",
  "version": "0.1.0",
  "private": true,
  "description": "Private Claude and Codex session inbox with Cloudflare hosting and a local execution host",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server/main.ts",
    "start": "node --experimental-strip-types server/main.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "status": "node --experimental-strip-types server/cli-status.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --module nodenext --target es2022 --skipLibCheck server/*.ts scripts/*.ts tests/*.ts",
    "hooks:codex:install": "node scripts/install-codex-hooks.mjs",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.mjs --uninstall",
    "service:install": "node scripts/service.mjs install",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "service:status": "node scripts/service.mjs status",
    "service:restart": "node scripts/service.mjs restart",
    "probe:claude": "node --experimental-strip-types scripts/probe-claude-control.ts",
    "probe:claude:peer": "node --experimental-strip-types scripts/probe-claude-peer.ts",
    "probe:codex": "node --experimental-strip-types scripts/probe-codex-control.ts",
    "cloud:dev": "wrangler dev",
    "cloud:deploy": "node scripts/deploy-cloud.mjs",
    "cloud:types": "wrangler types cloud/worker-configuration.d.ts",
    "cloud:typecheck": "tsc -p cloud/tsconfig.json && tsc -p cloud/tests/tsconfig.json",
    "cloud:test": "vitest run",
    "test:ui": "playwright test",
    "probe:mvp": "node --experimental-strip-types scripts/probe-mvp.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "jose": "^6.2.12",
    "ws": "^8.21.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
